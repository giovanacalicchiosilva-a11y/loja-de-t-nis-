<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CodeWear | Moda Dev</title>
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <header class="cabecalho">
        <div class="cabecalho__container">
            <h1 class="cabecalho__logo">&lt;CodeWear/&gt;</h1>
            <nav class="cabecalho__nav">
                <a href="#produtos" class="cabecalho__link">Produtos</a>
                <a href="#sobre" class="cabecalho__link">Sobre</a>
                <a href="#contato" class="cabecalho__link">Contato</a>
            </nav>
        </div>
    </header>

    <section class="banner">
        <div class="banner__conteudo">
            <h2 class="banner__titulo">Vista o seu código</h2>
            <p class="banner__texto">Estilo e conforto para devs que transformam linhas de código em soluções.</p>
            <a href="#produtos" class="banner__botao">Ver Coleção</a>
        </div>
    </section>

    <main class="produtos" id="produtos">
        <h2 class="produtos__titulo">Lançamentos</h2>
        <div class="produtos__grid">
            <article class="cartao">
                <div class="cartao__imagem cartao__imagem--1"></div>
                <h3 class="cartao__titulo">Camiseta Dev Senior</h3>
                <p class="cartao__descricao">100% Algodão. Não encolhe, igual ao seu deploy perfeito em produção.</p>
                <span class="cartao__preco">R$ 89,90</span>
                <button class="cartao__botao">Comprar</button>
            </article>

            <article class="cartao">
                <div class="cartao__imagem cartao__imagem--2"></div>
                <h3 class="cartao__titulo">Moletom Dark Mode</h3>
                <p class="cartao__descricao">Proteção ideal contra o ar-condicionado e bugs de última hora.</p>
                <span class="cartao__preco">R$ 199,90</span>
                <button class="cartao__botao">Comprar</button>
            </article>

            <article class="cartao">
                <div class="cartao__imagem cartao__imagem--3"></div>
                <h3 class="cartao__titulo">Boné CSS Flexbox</h3>
                <p class="cartao__descricao">Ajuste perfeito centralizado com justify-content: center.</p>
                <span class="cartao__preco">R$ 69,90</span>
                <button class="cartao__botao">Comprar</button>
            </article>
        </div>
    </main>

    <footer class="rodape">
        <p class="rodape__texto">&copy; 2026 CodeWear - Projeto desenvolvido na didática Alura.</p>
    </footer>

</<button>❤️</button>dy>
</html>